<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>

            <div class="main-content">
                <div class="dashboard-container">
                    <header>
                        <div>
                            <h1 style="margin: 0; font-size: 1.5rem;">⚙️ ตั้งค่าสูตรคำนวณ (Estimate Calibration)</h1>
                            <span class="text-muted" style="font-size: 0.9rem;">ปรับแต่งตัวแปรในการคำนวณระยะเวลา
                                Pentest</span>
                        </div>
                        <%- include('../partials/header_user_menu') %>
                    </header>

                    <div class="content">

<style>
.inline-tooltip {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: help;
}
.inline-tooltip .inline-tooltip-text {
    visibility: hidden;
    width: max-content;
    max-width: 250px;
    background-color: #1e293b;
    color: #fff;
    text-align: left;
    border-radius: 6px;
    padding: 8px 12px;
    position: absolute;
    z-index: 9999;
    bottom: 150%;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.2s;
    font-size: 0.85rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    white-space: normal;
    font-weight: 400;
    line-height: 1.4;
    pointer-events: none;
}
.inline-tooltip .inline-tooltip-text::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: #1e293b transparent transparent transparent;
}
.inline-tooltip:hover .inline-tooltip-text {
    visibility: visible;
    opacity: 1;
}
</style>

                        <% if (locals.error) { %>
                            <div class="error">
                                <%= error %>
                            </div>
                            <% } %>
                                <% if (locals.success) { %>
                                    <div
                                        style="background-color: #d1fae5; color: #065f46; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1.5rem; text-align: center; border: 1px solid #a7f3d0;">
                                        <%= success %>
                                    </div>
                                    <% } %>

                                        <div class="card">
                                            <form action="/update-config" method="POST" id="configForm">
                                                <input type="hidden" name="action" id="formAction" value="save">

                                                <!-- Base Parameters -->
                                                <div class="setting-group">
                                                    <h4>🕒 ค่าพื้นฐาน (Base Parameters)</h4>
                                                    <div
                                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                                        <div class="form-group">
                                                            <label for="hours_per_function" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">เวลาต่อฟังก์ชัน  (Hours per Function)
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">เวลาเฉลี่ยที่ใช้ในการตรวจสอบและประเมินช่องโหว่ความปลอดภัยต่อ 1 ฟังก์ชันการทำงานหลักของระบบ (เช่น ระบบ Login คิดเป็น 1 ฟังก์ชัน)</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="hours_per_function"
                                                                name="hours_per_function"
                                                                value="<%= config.hours_per_function %>" required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 2.0 ชั่วโมง</small>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="report_overhead_hours" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">เวลาทำรายงาน  (Report Overhead Hours)
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">เวลาที่เผื่อไว้สำหรับการจัดทำและสรุปรายงาน (ชั่วโมง)</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="report_overhead_hours"
                                                                name="report_overhead_hours"
                                                                value="<%= config.report_overhead_hours %>" required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 8.0 ชั่วโมง (1
                                                                วัน)</small>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Test Type Factors -->
                                                <div class="setting-group">
                                                    <h4>🔍 รูปแบบการทดสอบ (Test Type Factors)</h4>
                                                    <div
                                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                                        <div class="form-group">
                                                            <label for="graybox_factor" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">Gray Box Factor
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">ตัวคูณระยะเวลาสำหรับการทดสอบแบบรู้ข้อมูลระบบบางส่วน (มาตรฐานคือ 1.0)</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="graybox_factor"
                                                                name="graybox_factor"
                                                                value="<%= config.graybox_factor %>" required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 1.0 (มาตรฐาน)</small>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="blackbox_factor" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">Black Box Factor
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">ตัวคูณระยะเวลาสำหรับการทดสอบโดยไม่รู้ข้อมูลระบบเลย (ใช้เวลามากกว่า)</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="blackbox_factor"
                                                                name="blackbox_factor"
                                                                value="<%= config.blackbox_factor %>" required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 1.5 (ยากกว่า)</small>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Device Type Factors -->
                                                <div class="setting-group">
                                                    <h4>📱 ประเภทอุปกรณ์ (Device Type Factors)</h4>
                                                    <div
                                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                                        <div class="form-group">
                                                            <label for="web_factor" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">Web Application
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">ตัวคูณสำหรับระบบประเภทเว็บแอปพลิเคชัน</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="web_factor"
                                                                name="web_factor" value="<%= config.web_factor %>"
                                                                required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 1.0</small>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="mobile_factor" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">Mobile Application
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">ตัวคูณสำหรับระบบแอปพลิเคชันมือถือ (มักจะใช้เวลาตรวจสอบนานกว่าเว็บ)</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="mobile_factor"
                                                                name="mobile_factor" value="<%= config.mobile_factor %>"
                                                                required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 1.2</small>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="api_factor" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">API / Webservice
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">ตัวคูณสำหรับระบบ API (มักจะใช้เวลาน้อยกว่าหน้าเว็บที่มี UI)</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="api_factor"
                                                                name="api_factor" value="<%= config.api_factor %>"
                                                                required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 0.9</small>
                                                        </div>
                                                        <div class="form-group">
                                                            <label for="infra_factor" style="display: flex; align-items: center; gap: 0.35rem; margin-bottom: 0.5rem;">Infrastructure
    <span class="inline-tooltip">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="text-muted" viewBox="0 0 16 16"><path d="M5.255 5.786a.237.237 0 0 0 .241.247h.825c.138 0 .248-.113.266-.25.09-.656.54-1.134 1.342-1.134.686 0 1.314.343 1.314 1.168 0 .635-.374.927-.965 1.371-.673.489-1.206 1.06-1.168 1.987l.003.217a.25.25 0 0 0 .25.246h.811a.25.25 0 0 0 .25-.25v-.105c0-.718.273-.927 1.01-1.486.609-.463 1.244-.977 1.244-2.056 0-1.511-1.276-2.241-2.673-2.241-1.267 0-2.655.59-2.75 2.286zm1.557 5.763c0 .533.425.927 1.01.927.609 0 1.028-.394 1.028-.927 0-.552-.42-.94-1.029-.94-.584 0-1.009.388-1.009.94z"/><path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14z"/></svg>
        <span class="inline-tooltip-text">ตัวคูณสำหรับโครงสร้างพื้นฐานหรือระบบเครือข่าย</span>
    </span>
</label>
                                                            <input type="number" step="0.1" id="infra_factor"
                                                                name="infra_factor" value="<%= config.infra_factor %>"
                                                                required>
                                                            <small class="text-muted">ค่าเริ่มต้น: 0.5</small>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- OWASP Test Cases Base Hours -->
                                                <div class="setting-group">
                                                    <h4>🛡️ OWASP WSTG Base Hours (เวลามาตรฐานต่อเคส)</h4>
                                                    <p class="text-muted">กำหนดเวลามาตรฐาน (ชั่วโมง)
                                                        สำหรับการทดสอบแต่ละหัวข้อ</p>
                                                    <div style="overflow-x: auto;">
                                                        <table
                                                            style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                                                            <thead>
                                                                <tr
                                                                    style="background-color: #f3f4f6; text-align: left;">
                                                                    <th
                                                                        style="padding: 0.5rem; border-bottom: 2px solid #e5e7eb;">
                                                                        Code</th>
                                                                    <th
                                                                        style="padding: 0.5rem; border-bottom: 2px solid #e5e7eb;">
                                                                        Category</th>
                                                                    <th
                                                                        style="padding: 0.5rem; border-bottom: 2px solid #e5e7eb;">
                                                                        Name</th>
                                                                    <th
                                                                        style="padding: 0.5rem; border-bottom: 2px solid #e5e7eb;">
                                                                        Base Hours</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <% if (locals.testCases) { %>
                                                                    <% testCases.forEach(test=> { %>
                                                                        <tr style="border-bottom: 1px solid #e5e7eb;">
                                                                            <td
                                                                                style="padding: 0.5rem; font-weight: bold;">
                                                                                <%= test.code %>
                                                                            </td>
                                                                            <td style="padding: 0.5rem;">
                                                                                <%= test.category %>
                                                                            </td>
                                                                            <td style="padding: 0.5rem;">
                                                                                <%= test.name %>
                                                                            </td>
                                                                            <td style="padding: 0.5rem;">
                                                                                <input type="number" step="0.1" min="0"
                                                                                    name="wstg_<%= test.id %>"
                                                                                    value="<%= test.base_hours %>"
                                                                                    style="width: 80px; padding: 0.25rem;">
                                                                                Hrs
                                                                            </td>
                                                                        </tr>
                                                                        <% }) %>
                                                                            <% } %>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <div style="display: flex; gap: 1rem; margin-top: 2rem;">
                                                    <button type="button" class="btn btn-secondary"
                                                        onclick="showResetModal(event)"
                                                        style="flex: 1; padding: 1rem; font-size: 1.1rem; border: 1px solid #dc2626; color: #dc2626; background: white;">
                                                        🔄 รีเซ็ตค่าเริ่มต้น (Reset Default)
                                                    </button>
                                                    <button type="button" class="btn" onclick="showConfirmModal(event)"
                                                        style="flex: 2; padding: 1rem; font-size: 1.1rem;">
                                                        💾 บันทึกการตั้งค่า (Save Configuration)
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- Save Confirmation Modal -->
    <div id="confirmModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 480px; border-top: 5px solid var(--primary-color);">
            <div class="modal-header">
                <h3 style="margin: 0; color: var(--primary-color); display: flex; align-items: center; gap: 0.5rem;">
                    🛡️ ยืนยันการเปลี่ยนแปลง
                </h3>
                <button type="button" class="close-modal" onclick="closeModal('confirmModal')">&times;</button>
            </div>
            <div class="modal-body" style="background: white; padding: 2rem;">
                <p style="text-align: center; font-size: 1.1rem; color: var(--text-primary); margin-bottom: 1.5rem;">
                    คุณต้องการบันทึกการเปลี่ยนแปลงค่า configuration หรือไม่?
                </p>
                <div
                    style="background-color: #fffbeb; border: 1px solid #fde68a; padding: 1rem; border-radius: 0.5rem; display: flex; gap: 0.75rem; align-items: flex-start;">
                    <span style="font-size: 1.25rem;">⚠️</span>
                    <span style="font-size: 0.9rem; color: #92400e;">
                        การเปลี่ยนแปลงจะมีผลทันทีต่อการคำนวณราคาและระยะเวลาการทำงานใหม่ทั้งหมดในระบบ
                    </span>
                </div>
            </div>
            <div class="modal-footer"
                style="background: #f8fafc; display: flex; justify-content: flex-end; gap: 1rem; padding: 1.25rem 2rem;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('confirmModal')">ยกเลิก</button>
                <button type="button" class="btn" id="confirmSaveBtn" onclick="submitForm('save')">
                    💾 ยืนยันบันทึกข้อมูล
                </button>
            </div>
        </div>
    </div>

    <!-- Reset Confirmation Modal -->
    <div id="resetModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 480px; border-top: 5px solid #dc2626;">
            <div class="modal-header">
                <h3 style="margin: 0; color: #dc2626; display: flex; align-items: center; gap: 0.5rem;">
                    ⚠️ ยืนยันการรีเซ็ตค่า
                </h3>
                <button type="button" class="close-modal" onclick="closeModal('resetModal')">&times;</button>
            </div>
            <div class="modal-body" style="background: white; padding: 2rem;">
                <p style="text-align: center; font-size: 1.1rem; color: var(--text-primary); margin-bottom: 1.5rem;">
                    คุณต้องการรีเซ็ตค่าทั้งหมดกลับเป็นค่าเริ่มต้นหรือไม่?
                </p>
                <div
                    style="background-color: #fef2f2; border: 1px solid #fecaca; padding: 1rem; border-radius: 0.5rem; display: flex; gap: 0.75rem; align-items: flex-start;">
                    <span style="font-size: 1.25rem; color: #dc2626;">❗</span>
                    <span style="font-size: 0.9rem; color: #b91c1c;">
                        ค่าที่ตั้งไว้ทั้งหมดจะหายไปและกลับไปใช้ค่า Default ของระบบ การกระทำนี้ไม่สามารถย้อนกลับได้
                    </span>
                </div>
            </div>
            <div class="modal-footer"
                style="background: #f8fafc; display: flex; justify-content: flex-end; gap: 1rem; padding: 1.25rem 2rem;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('resetModal')">ยกเลิก</button>
                <button type="button" class="btn" id="confirmResetBtn" onclick="submitForm('reset')"
                    style="background: #dc2626; color: white;">
                    🔄 ยืนยันรีเซ็ต
                </button>
            </div>
        </div>
    </div>

    <script>
        function showConfirmModal(event) {
            event.preventDefault();
            const modal = document.getElementById('confirmModal');
            modal.style.display = 'flex';
            setTimeout(() => { modal.style.opacity = '1'; }, 10);
        }

        function showResetModal(event) {
            event.preventDefault();
            const modal = document.getElementById('resetModal');
            modal.style.display = 'flex';
            setTimeout(() => { modal.style.opacity = '1'; }, 10);
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.style.opacity = '0';
            setTimeout(() => { modal.style.display = 'none'; }, 300);
        }

        function submitForm(action) {
            const form = document.getElementById('configForm');
            const actionInput = document.getElementById('formAction');

            // Set action type
            actionInput.value = action;

            // Update button UI
            if (action === 'save') {
                const btn = document.getElementById('confirmSaveBtn');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังบันทึก...';
                btn.disabled = true;
            } else if (action === 'reset') {
                const btn = document.getElementById('confirmResetBtn');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังรีเซ็ต...';
                btn.disabled = true;
            }

            // Submit
            form.submit();
        }

        // Close on overlay click
        window.onclick = function (event) {
            if (event.target.classList.contains('modal-overlay')) {
                event.target.style.opacity = '0';
                setTimeout(() => { event.target.style.display = 'none'; }, 300);
            }
        }
    </script>
</body>

</html>