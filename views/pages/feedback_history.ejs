<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>
            <div class="main-content">
                <div class="dashboard-container">
                    <header>
                        <h1>Feedback History</h1>
                        <%- include('../partials/header_user_menu') %>
                    </header>
                    <div class="content card">
                        <p>Admin Access Only</p>
                        <table style="width:100%; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f3f4f6; text-align: left;">
                                    <th style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">วันที่ (Date)</th>
                                    <th style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">ผู้ใช้ (User)</th>
                                    <th style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">หัวข้อ (Subject)
                                    </th>
                                    <th style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">ข้อความ (Message)
                                    </th>
                                    <th style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">รูปภาพ (Attachment)
                                    </th>
                                    <th style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">จัดการ (Action)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (locals.feedbacks && feedbacks.length> 0) { %>
                                    <% feedbacks.forEach(fb=> { %>
                                        <tr style="border-bottom: 1px solid #e5e7eb;">
                                            <td style="padding: 0.75rem;">
                                                <%= new Date(fb.created_at).toLocaleString('th-TH') %>
                                            </td>
                                            <td style="padding: 0.75rem;">
                                                <strong>
                                                    <%= fb.username %>
                                                </strong>
                                            </td>
                                            <td style="padding: 0.75rem; font-weight: bold; color: #2563eb;">
                                                <%= fb.subject || 'No Subject' %>
                                            </td>
                                            <td style="padding: 0.75rem;">
                                                <%= fb.message %>
                                            </td>
                                            <td style="padding: 0.75rem;">
                                                <% if (fb.image_path) { %>
                                                    <a href="<%= fb.image_path %>" target="_blank"
                                                        style="color: #2563eb; text-decoration: underline;">
                                                        🖼️ ดูรูปภาพ
                                                    </a>
                                                    <% } else { %>
                                                        <span class="text-muted">-</span>
                                                        <% } %>
                                            </td>
                                            <td style="padding: 0.75rem;">
                                                <form action="/feedback/delete/<%= fb.id %>" method="POST"
                                                    onsubmit="return confirm('คุณแน่ใจว่าต้องการลบข้อเสนอแนะนี้?');">
                                                    <button type="submit"
                                                        style="background-color: #ef4444; color: white; border: none; padding: 0.5rem 1rem; border-radius: 0.375rem; cursor: pointer; font-size: 0.875rem;">
                                                        ลบ (Delete)
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6"
                                                        style="padding: 2rem; text-align: center; color: #6b7280;">
                                                        ไม่มีข้อมูล
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
    </div>
</body>

</html>