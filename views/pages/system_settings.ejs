<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
        <style>
            .setting-block {
                margin-bottom: 2rem;
                border: 1px solid #d1d5db;
                border-radius: 0.5rem;
                padding: 1.5rem;
                background: #f9fafb;
            }

            .setting-key {
                font-weight: bold;
                display: block;
                margin-bottom: 0.5rem;
                color: var(--primary-color);
            }

            .setting-desc {
                font-size: 0.85rem;
                color: #6b7280;
                margin-bottom: 0.5rem;
                display: block;
            }

            textarea.json-editor {
                width: 100%;
                min-height: 150px;
                font-family: monospace;
                padding: 0.75rem;
                border: 1px solid #9ca3af;
                border-radius: 0.375rem;
                font-size: 0.9rem;
                background-color: #ffffff;
            }

            textarea.json-editor:focus {
                outline: none;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.2);
            }
        </style>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>
            <div class="main-content">
                <div class="dashboard-container">
                    <header>
                        <h1 style="margin: 0; font-size: 1.5rem;">⚙️ System Settings</h1>
                        <p class="text-muted">Manage global rules, constraints, and operational parameters (JSON
                            format).</p>
                        <%- include('../partials/header_user_menu') %>
                    </header>

                    <div class="content">
                        <% if (locals.error) { %>
                            <div class="error">
                                <%= error %>
                            </div>
                            <% } %>
                                <% if (locals.success) { %>
                                    <div
                                        style="background-color: #d1fae5; color: #065f46; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1.5rem; text-align: center; border: 1px solid #a7f3d0;">
                                        <%= success %>
                                    </div>
                                    <% } %>

                                        <form action="/settings/system" method="POST">
                                            <% if (settings) { %>
                                                <% settings.forEach(setting=> { %>
                                                    <div class="setting-block">
                                                        <label class="setting-key" for="setting_<%= setting.key %>">
                                                            <%= setting.key %>
                                                        </label>
                                                        <span class="setting-desc">
                                                            <%= setting.description %>
                                                        </span>
                                                        <textarea class="json-editor" name="setting_<%= setting.key %>"
                                                            id="setting_<%= setting.key %>"
                                                            required><%= JSON.stringify(setting.value, null, 2) %></textarea>
                                                        <div id="validation_<%= setting.key %>"
                                                            style="color:red; font-size:0.8rem; margin-top:0.25rem;">
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                                        <% } %>

                                                            <button type="button" class="btn btn-primary"
                                                                style="width: 100%; margin-top: 1rem; padding: 1rem; font-size: 1.1rem;"
                                                                onclick="showConfirmModal(event)">
                                                                💾 Save System Settings
                                                            </button>
                                        </form>
                    </div>
                </div>
            </div>
    </div>

    <!-- Custom Confirmation Modal -->
    <div id="confirmModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 480px; border-top: 5px solid var(--primary-color);">
            <div class="modal-header">
                <h3 style="margin: 0; color: var(--primary-color);">🛡️ ยืนยันการบันทึกระบบ</h3>
                <button type="button" class="close-modal" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body" style="background: white; padding: 2rem;">
                <p style="text-align: center; font-size: 1.1rem; color: var(--text-primary); margin-bottom: 1.5rem;">
                    กรุณาตรวจสอบความถูกต้องของ JSON ก่อนบันทึก
                </p>
                <div
                    style="background-color: #fee2e2; border: 1px solid #fecaca; padding: 1rem; border-radius: 0.5rem; display: flex; gap: 0.75rem; align-items: flex-start;">
                    <span style="font-size: 1.25rem;">🛑</span>
                    <span style="font-size: 0.9rem; color: #991b1b;">
                        คำเตือน: หาก JSON ไม่ถูกต้อง อาจทำให้ระบบคำนวณราคาทำงานผิดพลาดหรือหยุดชะงักได้
                    </span>
                </div>
            </div>
            <div class="modal-footer"
                style="background: #f8fafc; display: flex; justify-content: flex-end; gap: 1rem; padding: 1.25rem 2rem;">
                <button type="button" class="btn btn-secondary" onclick="closeModal()">ยกเลิก</button>
                <button type="button" class="btn" id="confirmSaveBtn" onclick="submitForm()">
                    💾 ยืนยันและอัปเดตระบบ
                </button>
            </div>
        </div>
    </div>

    <script>
        function showConfirmModal(event) {
            event.preventDefault();
            const modal = document.getElementById('confirmModal');
            modal.style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('confirmModal').style.display = 'none';
        }

        function submitForm() {
            const btn = document.getElementById('confirmSaveBtn');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังอัปเดต...';
            btn.disabled = true;
            document.querySelector('form[action="/settings/system"]').submit();
        }

        window.onclick = function (event) {
            const modal = document.getElementById('confirmModal');
            if (event.target == modal) {
                closeModal();
            }
        }

        // Simple Client-side JSON Validation Feedback
        document.querySelectorAll('textarea.json-editor').forEach(ta => {
            ta.addEventListener('input', (e) => {
                const val = e.target.value;
                const feedback = document.getElementById('validation_' + e.target.id.replace('setting_', ''));
                try {
                    JSON.parse(val);
                    e.target.style.borderColor = '#10b981'; // Green
                    feedback.textContent = '';
                } catch (err) {
                    e.target.style.borderColor = '#ef4444'; // Red
                    feedback.textContent = 'Invalid JSON: ' + err.message;
                }
            });
        });
    </script>
</body>

</html>