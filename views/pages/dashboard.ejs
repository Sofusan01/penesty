<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>

            <div class="main-content">
                <div class="dashboard-container">
                    <header>
                        <div>
                            <h1 style="margin: 0; font-size: 1.5rem;">ประเมินราคา Pentest</h1>
                            <span class="text-muted" style="font-size: 0.9rem;">ระบบคำนวณระยะเวลาทดสอบเจาะระบบ</span>
                        </div>
                        <%- include('../partials/header_user_menu') %>
                    </header>

                    <div class="content">
                        <!-- Tabs Navigation -->
                        <div class="tabs-container">
                            <div class="tabs-nav">
                                <div class="tab-link active" onclick="openTab(this, 'estimation-tab')">
                                    <i class="fas fa-calculator"></i> ประเมินใหม่
                                </div>
                                <div class="tab-link" onclick="openTab(this, 'history-tab')">
                                    <i class="fas fa-history"></i> ประวัติการประเมิน
                                </div>
                            </div>
                        </div>

                        <% if (locals.error) { %>
                            <div class="error">
                                <%= error %>
                            </div>
                            <% } %>
                                <% if (locals.success) { %>
                                    <div
                                        style="background-color: #d1fae5; color: #065f46; padding: 0.75rem; border-radius: 0.5rem; margin-bottom: 1.5rem; text-align: center; border: 1px solid #a7f3d0;">
                                        <%= success %>
                                    </div>
                                    <% } %>

                                        <div id="estimation-tab" class="tab-content active">

                                            <% if (locals.previewResult && previewResult) { %>
                                                <!-- PREVIEW SECTION -->
                                                <div class="card"
                                                    style="border: 2px solid var(--primary-color); background-color: #f0f9ff;">
                                                    <h3 style="color: var(--primary-color);">📊 ผลการคำนวณ (Evaluation
                                                        Result)</h3>
                                                    <div
                                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                                        <div>
                                                            <strong>ลูกค้า:</strong>
                                                            <%= previewResult.client_name %><br>
                                                                <strong>ประเภท:</strong>
                                                                <%= previewResult.device_type %> (<%=
                                                                        previewResult.test_type %>)<br>
                                                                        <strong>Scope:</strong>
                                                                        <%= previewResult.target_info || '-' %><br>
                                                                            <strong>Roles:</strong>
                                                                            <%= previewResult.number_of_roles || 1 %>
                                                                                <br>
                                                                                <strong>ฟังก์ชัน:</strong>
                                                                                <%= previewResult.function_count %>
                                                                                    รายการ<br>
                                                                                    <!-- Platform hidden by request -->
                                                                                    <strong
                                                                                        style="color: var(--primary-color); font-size: 1.2rem;">ระยะเวลา:
                                                                                        <%= previewResult.estimated_days
                                                                                            %>
                                                                                            Man-Days
                                                                                    </strong>

                                                                                    <% if (previewResult.wstg_list &&
                                                                                        previewResult.wstg_list.length>
                                                                                        0) { %>
                                                                                        <div
                                                                                            style="margin-top: 0.5rem; font-size: 0.8rem; color: #666;">
                                                                                            <small>Includes <%=
                                                                                                    previewResult.wstg_list.length
                                                                                                    %> OWASP test
                                                                                                    cases.</small>
                                                                                        </div>
                                                                                        <% } %>
                                                        </div>
                                                        <div
                                                            style="text-align: right; display: flex; flex-direction: column; gap: 0.5rem;">
                                                            <form method="POST"
                                                                onsubmit="submitHiddenForm(event, 'L2Rhc2hib2FyZC9jb25maXJt')">
                                                                <input type="hidden" name="client_name"
                                                                    value="<%= previewResult.client_name %>">
                                                                <input type="hidden" name="device_type"
                                                                    value="<%= previewResult.device_type %>">
                                                                <input type="hidden" name="test_type"
                                                                    value="<%= previewResult.test_type %>">
                                                                <input type="hidden" name="target_url"
                                                                    value="<%= previewResult.target_info %>">
                                                                <input type="hidden" name="number_of_roles"
                                                                    value="<%= previewResult.number_of_roles %>">
                                                                <input type="hidden" name="selected_functions_json"
                                                                    value="<%= JSON.stringify(previewResult.selected_functions || []) %>">
                                                                <input type="hidden" name="platform_count" value="1">

                                                                <button type="submit" class="btn btn-primary"
                                                                    style="width: 100%;">💾 บันทึก (Save)</button>
                                                            </form>
                                                            <a href="/dashboard" class="btn"
                                                                style="width: 100%; background-color: #6b7280; text-align: center;">❌
                                                                ยกเลิก</a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% } else { %>
                                                    <!-- Estimation Form -->
                                                    <div class="card">
                                                        <h3>🛠️ สร้างการประเมินใหม่ (New Estimation)</h3>
                                                        <form method="POST"
                                                            onsubmit="submitHiddenForm(event, 'L2Rhc2hib2FyZC9lc3RpbWF0ZQ==')">
                                                            <div class="form-grid"
                                                                style="display: grid; grid-template-columns: 1fr; gap: 1rem;">
                                                                <!-- Merged Client/Target Info -->
                                                                <div class="form-group">
                                                                    <label for="client_name">ข้อมูลลูกค้า / เป้าหมาย
                                                                        (Client
                                                                        & Target Info) <span
                                                                            class="text-danger">*</span></label>
                                                                    <input type="text" id="client_name"
                                                                        name="client_name"
                                                                        placeholder="ระบุชื่อลูกค้าและเป้าหมาย เช่น 'Acme Corp - www.acme.com'"
                                                                        required maxlength="255">
                                                                </div>
                                                            </div>

                                                            <div class="form-grid"
                                                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                                                <!-- Roles -->
                                                                <div class="form-group">
                                                                    <label for="number_of_roles">จำนวน Role (Number of
                                                                        Roles) <span
                                                                            class="text-danger">*</span></label>
                                                                    <input type="number" id="number_of_roles"
                                                                        name="number_of_roles" min="1" max="20"
                                                                        value="1" required
                                                                        onkeydown="if(['e', 'E', '+', '-', '.'].includes(event.key)) event.preventDefault()">
                                                                </div>


                                                            </div>

                                                            <div class="form-grid"
                                                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                                                <!-- Device Type -->
                                                                <div class="form-group">
                                                                    <label for="device_type">ชนิดเป้าหมาย (System Type)
                                                                        <span class="text-danger">*</span></label>
                                                                    <select id="device_type" name="device_type" required
                                                                        style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #f9fafb;">
                                                                        <option value="web_application">Web Application
                                                                        </option>
                                                                        <option value="mobile_application">Mobile
                                                                            Application</option>
                                                                        <option value="api_webservice">API / Webservice
                                                                        </option>
                                                                        <option value="infrastructure">Infrastructure /
                                                                            Network</option>
                                                                    </select>
                                                                </div>

                                                                <!-- Test Type -->
                                                                <div class="form-group">
                                                                    <label for="test_type">รูปแบบการทดสอบ (Test Type)
                                                                        <span class="text-danger">*</span></label>
                                                                    <select id="test_type" name="test_type" required
                                                                        style="width: 100%; padding: 0.75rem; border: 1px solid #d1d5db; border-radius: 0.5rem; background: #f9fafb;">
                                                                        <option value="graybox">Gray Box (Authenticated)
                                                                        </option>
                                                                        <option value="blackbox">Black Box
                                                                            (Unauthenticated)
                                                                        </option>
                                                                    </select>
                                                                </div>
                                                            </div>



                                                            <div class="form-group">
                                                                <label>เลือกฟังก์ชันระบบ (Business Functions) <span
                                                                        class="text-danger">*</span></label>
                                                                <div
                                                                    style="max-height: 300px; overflow-y: auto; border: 1px solid #e5e7eb; padding: 1rem; border-radius: 0.5rem; background: #f9fafb;">
                                                                    <% if (locals.appFunctions) { %>
                                                                        <% appFunctions.forEach(func=> { %>
                                                                            <div class="checkbox-group"
                                                                                style="margin-bottom: 0.5rem; padding: 0.5rem; border-bottom: 1px solid #eee;">
                                                                                <input type="checkbox"
                                                                                    id="func_<%= func.id %>"
                                                                                    name="selected_functions"
                                                                                    value="<%= func.id %>">
                                                                                <label for="func_<%= func.id %>"
                                                                                    style="display: inline; font-weight: normal; cursor: pointer;">
                                                                                    <strong style="color: #374151;">
                                                                                        <%= func.name %>
                                                                                    </strong>
                                                                                    <div
                                                                                        style="font-size: 0.85rem; color: #6b7280; margin-left: 1.5rem;">
                                                                                        <%= func.description %>
                                                                                    </div>
                                                                                </label>
                                                                            </div>
                                                                            <% }) %>
                                                                                <% } else { %>
                                                                                    <p>ไม่พบข้อมูลฟังก์ชัน</p>
                                                                                    <% } %>
                                                                </div>
                                                                <small
                                                                    class="text-muted">เลือกฟังก์ชันที่เกี่ยวข้องเพื่อคำนวณ
                                                                    Scope งาน (OWASP WSTG Mapping)</small>
                                                            </div>

                                                            <button type="submit" class="btn btn-primary"
                                                                style="width: 100%; margin-top: 1rem; padding: 1rem; font-size: 1.1rem;">
                                                                🚀 คำนวณราคาประเมิน (Calculate Estimate)
                                                            </button>
                                                        </form>
                                                    </div>

                                                    <!-- Data for Client Constraints -->
                                                    <script id="constraints-data" type="application/json">
                                                    <%- JSON.stringify(locals.constraints || {}) %>
                                                </script>

                                                    <script>
                                                        const deviceSelect = document.getElementById('device_type');
                                                        const testSelect = document.getElementById('test_type');

                                                        let constraints = {};
                                                        try {
                                                            constraints = JSON.parse(document.getElementById('constraints-data').textContent);
                                                        } catch (e) { console.error(e); }

                                                        function updateUI() {
                                                            const device = deviceSelect.value;

                                                            // 1. Update Target Inputs - No longer needed as we use a single consolidated input
                                                            // targetUrl.style.display = 'none'; targetUrl.removeAttribute('required');
                                                            // ... kept singular logic

                                                            // 2. Update Test Type Constraints
                                                            const allowed = constraints[device] || [];
                                                            const options = testSelect.options;

                                                            for (let i = 0; i < options.length; i++) {
                                                                const opt = options[i];
                                                                // Enable if allowed
                                                                if (allowed.includes(opt.value)) {
                                                                    opt.disabled = false;
                                                                    opt.hidden = false;
                                                                } else {
                                                                    opt.disabled = true;
                                                                    opt.hidden = true;
                                                                }
                                                            }

                                                            // Auto-select valid option if current is invalid
                                                            if (!allowed.includes(testSelect.value)) {
                                                                // Find first enabled option
                                                                for (let i = 0; i < options.length; i++) {
                                                                    if (!options[i].disabled) {
                                                                        testSelect.value = options[i].value;
                                                                        break;
                                                                    }
                                                                }
                                                            }
                                                        }

                                                        deviceSelect.addEventListener('change', updateUI);
                                                        // Init
                                                        updateUI();
                                                    </script>
                                                    <% } %>
                                        </div>

                                        <div id="history-tab" class="tab-content">


                                            <!-- History Table -->
                                            <div class="card">
                                                <div
                                                    style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                                                    <h3 style="margin: 0;">📜 ประวัติการประเมิน (History)</h3>
                                                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                                                        <!-- Default Actions -->
                                                        <div id="default-actions" style="display: flex; gap: 0.75rem;">
                                                            <button type="button" class="btn btn-secondary"
                                                                onclick="enterMode('csv')"
                                                                style="background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem;">
                                                                <i class="fas fa-download"></i> ส่งออก CSV
                                                            </button>
                                                            <button type="button" class="btn"
                                                                onclick="enterMode('delete')"
                                                                style="background-color: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem;">
                                                                <i class="fas fa-trash-alt"></i> ลบข้อมูล
                                                            </button>
                                                        </div>

                                                        <!-- CSV Selection Mode -->
                                                        <div id="csv-actions"
                                                            style="display: none; gap: 0.75rem; align-items: center;">
                                                            <span
                                                                style="color: var(--primary-color); font-weight: 600; font-size: 0.9rem; white-space: nowrap;">เลือกรายการส่งออก:</span>
                                                            <button type="button" class="btn btn-secondary"
                                                                onclick="exitMode()"
                                                                style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
                                                                ยกเลิก (Cancel)
                                                            </button>
                                                            <button type="button" class="btn" onclick="executeCSV()"
                                                                style="background-color: var(--success-color); padding: 0.4rem 0.8rem; font-size: 0.9rem;">
                                                                ยืนยัน (Confirm)
                                                            </button>
                                                        </div>

                                                        <!-- Delete Selection Mode -->
                                                        <div id="delete-actions"
                                                            style="display: none; gap: 0.75rem; align-items: center;">
                                                            <span
                                                                style="color: var(--danger-color); font-weight: 600; font-size: 0.9rem; white-space: nowrap;">เลือกรายการลบ:</span>
                                                            <button type="button" class="btn btn-secondary"
                                                                onclick="exitMode()"
                                                                style="padding: 0.4rem 0.8rem; font-size: 0.9rem;">
                                                                ยกเลิก (Cancel)
                                                            </button>
                                                            <button type="button" class="btn"
                                                                onclick="confirmBulkDelete()"
                                                                style="background-color: var(--danger-color); padding: 0.4rem 0.8rem; font-size: 0.9rem;">
                                                                ยืนยัน (Confirm)
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div style="overflow-x: auto;">
                                                    <table
                                                        style="width: 100%; border-collapse: collapse; margin-top: 1rem;">
                                                        <thead>
                                                            <tr style="background: #f3f4f6; text-align: left;">
                                                                <th class="checkbox-col"
                                                                    style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb; width: 40px; text-align: center; display: none;">
                                                                    <input type="checkbox" id="selectAllEst"
                                                                        onclick="toggleSelectAllRecords(this)"
                                                                        style="width: 18px; height: 18px; cursor: pointer;">
                                                                </th>
                                                                <th
                                                                    style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">
                                                                    <a href="?tab=history&page=1&order=<%= (locals.order === 'ASC') ? 'DESC' : 'ASC' %>"
                                                                        style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 4px;">
                                                                        ลำดับ <span style="font-size: 0.8em;">
                                                                            <%= (locals.order==='ASC' ) ? '▲' : '▼' %>
                                                                        </span>
                                                                    </a>
                                                                </th>
                                                                <th
                                                                    style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">
                                                                    ลูกค้า</th>
                                                                <th
                                                                    style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">
                                                                    ประเภท</th>
                                                                <th
                                                                    style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb;">
                                                                    จำนวนฟังก์ชัน</th>
                                                                <th
                                                                    style="padding: 0.75rem; border-bottom: 2px solid #e5e7eb; color: var(--primary-color);">
                                                                    เวลาประเมิน (Man-Days)</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <% if (locals.estimations && estimations.length> 0) { %>
                                                                <% estimations.forEach((est, index)=> { %>
                                                                    <tr style="border-bottom: 1px solid #e5e7eb;"
                                                                        class="history-row">
                                                                        <td class="checkbox-col"
                                                                            style="padding: 0.75rem; text-align: center; display: none;">
                                                                            <input type="checkbox"
                                                                                class="record-checkbox"
                                                                                value="<%= est.id %>"
                                                                                style="width: 18px; height: 18px; cursor: pointer;">
                                                                        </td>
                                                                        <td style="padding: 0.75rem;">
                                                                            <%= (locals.order==='ASC' ) ?
                                                                                (((locals.currentPage || 1) - 1) * 10 +
                                                                                index + 1) : (locals.totalItems -
                                                                                (((locals.currentPage || 1) - 1) * 10) -
                                                                                index) %>
                                                                        </td>
                                                                        <td style="padding: 0.75rem;">
                                                                            <%= est.client_name %>
                                                                        </td>
                                                                        <td style="padding: 0.75rem;">
                                                                            <span
                                                                                style="font-size: 0.85rem; font-weight: bold;">
                                                                                <%= est.device_type %>
                                                                            </span><br>
                                                                            <span
                                                                                style="font-size: 0.75rem; color: #6b7280;">
                                                                                <%= est.test_type %>
                                                                            </span>
                                                                        </td>
                                                                        <td style="padding: 0.75rem;">
                                                                            <% if (est.selected_functions &&
                                                                                est.selected_functions !=='[]' ) { %>
                                                                                <div class="function-count-link tooltip-btn"
                                                                                    data-functions='<%- est.selected_functions %>'
                                                                                    data-client="<%= est.client_name %>"
                                                                                    onclick="handleViewFunctions(this)"
                                                                                    data-tooltip="คลิกเพื่อดูรายละเอียด"
                                                                                    style="cursor: pointer; color: var(--primary-color); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; display: inline-block;">
                                                                                    <%= est.function_count %> ฟังก์ชัน
                                                                                </div>
                                                                                <% } else { %>
                                                                                    <div
                                                                                        style="color: var(--text-secondary);">
                                                                                        <%= est.function_count %>
                                                                                            ฟังก์ชัน
                                                                                    </div>
                                                                                    <% } %>
                                                                        </td>
                                                                        <td
                                                                            style="padding: 0.75rem; font-size: 1.1rem; font-weight: bold; color: var(--primary-color);">
                                                                            <%= Math.ceil(est.estimated_days) %> วัน
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } else { %>
                                                                            <tr>
                                                                                <td colspan="6"
                                                                                    style="text-align: center; padding: 3rem; color: #6b7280;">
                                                                                    <i class="fas fa-folder-open"
                                                                                        style="font-size: 2rem; display: block; margin-bottom: 1rem; opacity: 0.5;"></i>
                                                                                    ยังไม่มีประวัติการประเมิน
                                                                                </td>
                                                                            </tr>
                                                                            <% } %>
                                                        </tbody>
                                                    </table>
                                                </div>

                                                <!-- Pagination -->
                                                <% if (locals.totalPages && totalPages> 1) { %>
                                                    <div
                                                        style="display: flex; justify-content: flex-end; align-items: center; margin-top: 12px; gap: 8px;">
                                                        <% if (typeof currentPage !=='undefined' && currentPage> 1) { %>
                                                            <a href="?tab=history&page=<%= currentPage - 1 %>&order=<%= locals.order || 'DESC' %>"
                                                                class="btn"
                                                                style="padding: 4px 10px; font-size: 14px; background: #fff; border: 1px solid #d1d5db; color: #374151; border-radius: 4px; width: auto; flex-grow: 0;">&lt;</a>
                                                            <% } %>

                                                                <% let shownDotsBefore=false; let shownDotsAfter=false;
                                                                    for(let i=1; i <=totalPages; i++) { if (i===1 ||
                                                                    i===totalPages || i===currentPage) { if
                                                                    (i===currentPage) { %>
                                                                    <span
                                                                        style="padding: 4px 10px; font-size: 14px; background: var(--primary-color); color: white; border: 1px solid var(--primary-color); border-radius: 4px; cursor: default;">
                                                                        <%= i %>
                                                                    </span>
                                                                    <% } else { %>
                                                                        <a href="?tab=history&page=<%= i %>&order=<%= locals.order || 'DESC' %>"
                                                                            style="padding: 4px 10px; font-size: 14px; background: #fff; border: 1px solid #d1d5db; color: #374151; border-radius: 4px; text-decoration: none;">
                                                                            <%= i %>
                                                                        </a>
                                                                        <% } } else if (i < currentPage &&
                                                                            !shownDotsBefore) { shownDotsBefore=true; %>
                                                                            <span
                                                                                style="padding: 4px 8px; color: #6b7280;">...</span>
                                                                            <% } else if (i> currentPage &&
                                                                                !shownDotsAfter) { shownDotsAfter =
                                                                                true; %>
                                                                                <span
                                                                                    style="padding: 4px 8px; color: #6b7280;">...</span>
                                                                                <% } } %>

                                                                                    <% if (typeof currentPage
                                                                                        !=='undefined' && currentPage <
                                                                                        totalPages) { %>
                                                                                        <a href="?tab=history&page=<%= currentPage + 1 %>&order=<%= locals.order || 'DESC' %>"
                                                                                            class="btn"
                                                                                            style="padding: 4px 10px; font-size: 14px; background: #fff; border: 1px solid #d1d5db; color: #374151; border-radius: 4px; width: auto; flex-grow: 0;">></a>
                                                                                        <% } %>
                                                    </div>
                                                    <div
                                                        style="text-align: right; font-size: 0.8rem; color: #6b7280; margin-top: 4px;">
                                                        หน้า <%= currentPage %> จาก <%= totalPages %> (ทั้งหมด <%=
                                                                    totalItems %> รายการ)
                                                    </div>
                                                    <% } %>
                                            </div>
                                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- Hidden data for JS -->
    <div id="app-functions-data" style="display: none;">
        <%= JSON.stringify(locals.appFunctions || []) %>
    </div>


    <!-- Modal for Viewing Functions -->
    <div id="functionsModal" class="modal-overlay" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3 id="modalTitle" style="margin: 0;">ฟังก์ชันที่เลือก</h3>
                <button class="close-modal" onclick="closeModal()">×</button>
            </div>
            <div id="modalBody" class="modal-body">
                <!-- Functions will be injected here -->
            </div>
        </div>
    </div>

    <!-- Info/Warning Modal -->
    <div id="infoModal" class="modal-overlay" style="z-index: 2200;" onclick="closeInfoModal(event)">
        <div class="modal-content" style="max-width: 450px; text-align: center; border-top: 5px solid #f59e0b;"
            onclick="event.stopPropagation()">
            <div style="padding: 2.5rem 1.5rem;">
                <div style="font-size: 3rem; color: #f59e0b; margin-bottom: 1rem;">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <h3 id="infoModalTitle" style="margin-bottom: 0.5rem; color: #1f2937;">แจ้งเตือน</h3>
                <p id="infoModalMessage" style="color: #6b7280; margin-bottom: 2rem; font-size: 1.1rem;"></p>
                <button class="btn" onclick="closeInfoModal()" style="min-width: 120px; background: #6b7280;">ตกลง
                    (OK)</button>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal-overlay" style="z-index: 2100;">
        <div class="modal-content" style="max-width: 400px; text-align: center; padding: 0;"
            onclick="event.stopPropagation()">
            <div style="padding: 2rem 1.5rem;">
                <h3 style="margin-bottom: 0.5rem; color: #1f2937;">ยืนยันการลบข้อมูล?</h3>
                <p style="color: #6b7280; margin-bottom: 2rem;">คุณแน่ใจหรือไม่ที่จะลบรายการนี้?
                    <br>การกระทำนี้ไม่สามารถย้อนกลับได้
                </p>
                <div style="display: flex; gap: 1rem; justify-content: center;">
                    <button class="btn btn-secondary" onclick="closeDeleteModal()"
                        style="min-width: 100px;">ยกเลิก</button>
                    <button id="confirmDeleteBtn" class="btn"
                        style="background: var(--danger-color); min-width: 100px;">ลบข้อมูล</button>
                </div>
            </div>
        </div>
    </div>


    <script>
        // Mode Management
        function enterMode(mode) {
            // Hide default actions
            document.getElementById('default-actions').style.display = 'none';

            // Show Checkboxes
            const checkboxes = document.querySelectorAll('.checkbox-col');
            checkboxes.forEach(el => el.style.display = 'table-cell');

            // Show Specific Actions
            if (mode === 'csv') {
                document.getElementById('csv-actions').style.display = 'flex';
                document.getElementById('delete-actions').style.display = 'none';
            } else if (mode === 'delete') {
                document.getElementById('delete-actions').style.display = 'flex';
                document.getElementById('csv-actions').style.display = 'none';
            }
        }

        function exitMode() {
            // Reset Inputs
            const checkboxes = document.querySelectorAll('.record-checkbox');
            checkboxes.forEach(cb => cb.checked = false);
            const selectAll = document.getElementById('selectAllEst');
            if (selectAll) selectAll.checked = false;

            // Hide Checkboxes
            const checkboxCols = document.querySelectorAll('.checkbox-col');
            checkboxCols.forEach(el => el.style.display = 'none');

            // Reset Buttons
            document.getElementById('default-actions').style.display = 'flex';
            document.getElementById('csv-actions').style.display = 'none';
            document.getElementById('delete-actions').style.display = 'none';
        }

        function executeCSV() {
            exportToCSV();
            // Optional: exitMode() after export? Users might want to export multiple batches, but usually one is enough.
            // Let's keep it open or close it. Closing feels cleaner.
            exitMode();
        }

        // Global data for CSV Export
        const historyData = JSON.parse(decodeURIComponent('<%= encodeURIComponent(JSON.stringify(estimations || [])) %>'));
        const allFunctionsLookup = JSON.parse(decodeURIComponent('<%= encodeURIComponent(JSON.stringify(locals.appFunctions || [])) %>'));

        function toggleSelectAllRecords(source) {
            const checkboxes = document.getElementsByClassName('record-checkbox');
            for (let i = 0; i < checkboxes.length; i++) {
                checkboxes[i].checked = source.checked;
            }
        }

        function exportToCSV() {
            const checkboxes = document.querySelectorAll('.record-checkbox:checked');
            if (checkboxes.length === 0) {
                showInfoModal('กรุณาเลือกรายการที่ต้องการส่งออกอย่างน้อย 1 รายการ');
                return;
            }

            const selectedIds = Array.from(checkboxes).map(cb => parseInt(cb.value));
            const selectedData = historyData.filter(d => selectedIds.includes(d.id));

            // Define CSV Headers
            const headers = ['ID', 'Client Name', 'Target Info', 'Device Type', 'Test Type', 'Functions Details', 'Total Functions', 'Roles', 'Platforms', 'Estimated Days', 'Created At'];

            // Map data to rows
            const rows = selectedData.map(d => {
                let funcDetails = "";
                try {
                    const selectedIds = JSON.parse(d.selected_functions || "[]");
                    funcDetails = selectedIds.map(id => {
                        const f = allFunctionsLookup.find(item => item.id == id);
                        return f ? `${f.name}` : `ID:${id}`;
                    }).join(" | ");
                } catch (e) {
                    funcDetails = "Error parsing functions";
                }

                return [
                    d.id,
                    `"${d.client_name.replace(/"/g, '""')}"`,
                    `"${(d.target_info || '').replace(/"/g, '""')}"`,
                    d.device_type,
                    d.test_type,
                    `"${funcDetails.replace(/"/g, '""')}"`,
                    d.function_count,
                    d.number_of_roles,
                    d.platform_count,
                    Math.ceil(d.estimated_days),
                    d.created_at
                ];
            });

            // Combine into CSV string
            let csvContent = headers.join(',') + '\n';
            rows.forEach(row => {
                csvContent += row.join(',') + '\n';
            });

            // Trigger Download
            const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            const timestamp = new Date().toISOString().split('T')[0];

            link.setAttribute('href', url);
            link.setAttribute('download', `pentest_estimations_${timestamp}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function openTab(btn, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].classList.remove("active");
            }
            tablinks = document.getElementsByClassName("tab-link");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].classList.remove("active");
            }
            const targetTab = document.getElementById(tabName);
            if (targetTab) targetTab.classList.add("active");
            if (btn) btn.classList.add("active");
            localStorage.setItem('activeDashboardTab', tabName);
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Check URL query param 'tab'
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            let initialTab = localStorage.getItem('activeDashboardTab');

            if (tabParam === 'history') initialTab = 'history-tab';
            if (tabParam === 'estimation') initialTab = 'estimation-tab';

            if (initialTab && document.getElementById(initialTab)) {
                // Find tab button that opens this tab
                const tabButton = Array.from(document.querySelectorAll('.tab-link')).find(btn => {
                    return btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(initialTab);
                });
                if (tabButton) tabButton.click();
            }

            // Clean URL params after use (optional but nice UI)
            if (tabParam) {
                const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
                window.history.replaceState({ path: newUrl }, '', newUrl);
            }
        });

        // Load data from hidden element
        let allFunctionsData = [];
        try {
            const dataElem = document.getElementById('app-functions-data');
            if (dataElem) {
                allFunctionsData = JSON.parse(dataElem.innerText);
            }
        } catch (e) {
            console.error("Error parsing functions data:", e);
        }

        function handleViewFunctions(btn) {
            const functionsJson = btn.getAttribute('data-functions');
            const clientName = btn.getAttribute('data-client');
            viewFunctions(functionsJson, clientName);
        }

        function viewFunctions(functionsJson, clientName) {
            let selectedIds = [];
            try {
                selectedIds = JSON.parse(functionsJson);
            } catch (e) {
                return;
            }

            const modal = document.getElementById('functionsModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalBody = document.getElementById('modalBody');

            modalTitle.innerText = `ฟังก์ชันที่เลือก - ${clientName}`;
            modalBody.innerHTML = '';

            if (selectedIds.length === 0) {
                modalBody.innerHTML = '<p class="text-muted">ไม่มีข้อมูลฟังก์ชัน</p>';
            } else {
                const list = document.createElement('div');
                list.className = 'functions-list-display';
                selectedIds.forEach(id => {
                    const func = allFunctionsData.find(f => f.id == id);
                    if (func) {
                        const item = document.createElement('div');
                        item.className = 'function-item-display';
                        item.innerHTML = `
                            <div style="font-weight: 600; color: var(--text-primary);">${func.name}</div>
                            <div style="font-size: 0.85rem; color: var(--text-muted);">${func.description || ''}</div>
                        `;
                        list.appendChild(item);
                    }
                });
                modalBody.appendChild(list);
            }
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }


        function closeModal(e) {
            if (!e || e.target === document.getElementById('functionsModal') || e.target.classList.contains('close-modal') || e.target.tagName === 'BUTTON') {
                document.getElementById('functionsModal').style.display = 'none';
                document.body.style.overflow = 'auto';
            }
        }

        // Delete Modal Logic
        let deleteIds = [];

        function confirmBulkDelete() {
            const checkboxes = document.querySelectorAll('.record-checkbox:checked');
            if (checkboxes.length === 0) {
                showInfoModal('กรุณาเลือกรายการที่ต้องการลบอย่างน้อย 1 รายการ');
                return;
            }

            deleteIds = Array.from(checkboxes).map(cb => cb.value);
            const modal = document.getElementById('deleteModal');
            const modalText = modal.querySelector('p');
            modalText.innerHTML = `คุณแน่ใจหรือไม่ที่จะลบรายการที่เลือกทั้งหมด <strong>${deleteIds.length} รายการ</strong>?<br>การกระทำนี้ไม่สามารถย้อนกลับได้`;

            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';

            const confirmBtn = document.getElementById('confirmDeleteBtn');
            const newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);

            newConfirmBtn.onclick = async function () {
                newConfirmBtn.disabled = true;
                newConfirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังลบ...';

                // We'll use a form to post multiple IDs if our backend supported it, 
                // but since the current backend only has /delete/:id, 
                // we'll create a new bulk delete route or process them.
                // For now, to keep it simple and compatible, we'll use a form for bulk delete.
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = atob('L2Rhc2hib2FyZC9idWxrLWRlbGV0ZQ==');

                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'ids';
                input.value = JSON.stringify(deleteIds);
                form.appendChild(input);

                document.body.appendChild(form);
                form.submit();
            };
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').style.display = 'none';
            document.body.style.overflow = 'auto';
            deleteFormId = null;
        }

        function showInfoModal(message, title = 'แจ้งเตือน') {
            document.getElementById('infoModalTitle').innerText = title;
            document.getElementById('infoModalMessage').innerText = message;
            document.getElementById('infoModal').style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeInfoModal() {
            document.getElementById('infoModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // Close delete modal on outside click
        document.getElementById('deleteModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeDeleteModal();
            }
        });

        document.getElementById('infoModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeInfoModal();
            }
        });

        function submitHiddenForm(event, encodedPath) {
            // decode path
            const path = atob(encodedPath);
            event.target.action = path;
        }
    </script>
</body>

</html>