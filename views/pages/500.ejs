<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <div class="app-layout">
        <% if (locals.user) { %>
            <%- include('../partials/sidebar') %>
                <% } %>

                    <div class="main-content" <% if (!locals.user) { %> style="margin-left: 0; width: 100%;" <% } %>>
                            <div class="dashboard-container">
                                <header>
                                    <div>
                                        <h1 style="margin: 0; font-size: 1.5rem; color: var(--danger-color);">500
                                            Internal
                                            Server Error</h1>
                                        <span class="text-muted" style="font-size: 0.9rem;">เกิดข้อผิดพลาดที่ระบบ</span>
                                    </div>
                                    <% if (locals.user) { %>
                                        <%- include('../partials/header_user_menu') %>
                                            <% } %>
                                </header>

                                <div class="content">
                                    <div class="card"
                                        style="text-align: center; padding: 4rem 2rem; border-top: 5px solid var(--danger-color);">
                                        <div style="font-size: 4rem; color: var(--danger-color); margin-bottom: 1rem;">
                                            <i class="fas fa-server"></i>
                                        </div>
                                        <h2 style="margin-bottom: 1rem;">ขออภัย! ระบบเกิดข้อผิดพลาด</h2>
                                        <p style="color: var(--text-muted); margin-bottom: 1rem;">
                                            เราไม่สามารถดำเนินการตามคำขอของคุณได้ในขณะนี้ กรุณาลองใหม่อีกครั้งในภายหลัง
                                        </p>
                                        <div
                                            style="background-color: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 0.5rem; margin-bottom: 2rem; text-align: left; font-family: monospace; font-size: 0.9rem; overflow-x: auto;">
                                            <strong>รายละเอียดข้อผิดพลาด:</strong><br>
                                            <%= error %>
                                        </div>
                                        <a href="javascript:history.back()" class="btn btn-primary"
                                            style="display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center; min-width: 150px; margin-right: 1rem;">
                                            <i class="fas fa-arrow-left"></i> ย้อนกลับ
                                        </a>
                                        <a href="<%= locals.user ? '/dashboard' : '/' %>" class="btn btn-secondary"
                                            style="display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center; min-width: 150px;">
                                            <i class="fas fa-home"></i> กลับไปหน้าหลัก
                                        </a>
                                    </div>
                                </div>
                            </div>
                    </div>
    </div>
</body>

</html>