<!DOCTYPE html>
<html lang="th">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>
            <div class="main-content">
                <div class="dashboard-container">
                    <header>
                        <h1>Feedback</h1>
                        <%- include('../partials/header_user_menu') %>
                    </header>
                    <div class="content card">
                        <% if (locals.success) { %>
                            <div class="alert alert-success"
                                style="padding: 1rem; background-color: #d1fae5; color: #065f46; border-radius: 0.5rem; margin-bottom: 1rem;">
                                <%= success %>
                            </div>
                            <% } %>
                                <% if (locals.error) { %>
                                    <div class="alert alert-danger"
                                        style="padding: 1rem; background-color: #fee2e2; color: #991b1b; border-radius: 0.5rem; margin-bottom: 1rem;">
                                        <%= error %>
                                    </div>
                                    <% } %>

                                        <h3>Submit Feedback</h3>
                                        <form action="/feedback" method="POST" enctype="multipart/form-data">
                                            <div class="form-group" style="margin-bottom: 1rem;">
                                                <label for="subject"
                                                    style="display: block; margin-bottom: 0.5rem; font-weight: bold;">หัวข้อ
                                                    (Subject):</label>
                                                <input type="text" id="subject" name="subject" required
                                                    placeholder="เรื่องที่ต้องการแจ้ง..."
                                                    style="width:100%; padding:0.5rem; border: 1px solid #ddd; border-radius: 4px;">
                                            </div>

                                            <div class="form-group" style="margin-bottom: 1rem;">
                                                <label for="feedback"
                                                    style="display: block; margin-bottom: 0.5rem; font-weight: bold;">ข้อเสนอะแนะ
                                                    (Comments):</label>
                                                <textarea id="feedback" name="message" rows="5" required
                                                    placeholder="รายละเอียด..."
                                                    style="width:100%; padding:0.5rem; border: 1px solid #ddd; border-radius: 4px;"></textarea>
                                            </div>

                                            <div class="form-group" style="margin-bottom: 1rem;">
                                                <label for="image"
                                                    style="display: block; margin-bottom: 0.5rem; font-weight: bold;">แนบรูปภาพ
                                                    (Image) <small class="text-muted">(Optional)</small>
                                                    <span
                                                        style="font-weight: normal; font-size: 0.9em; color: #6c757d;">(รองรับ:
                                                        .jpg, .jpeg, .png, .gif)</span>:</label>
                                                <input type="file" id="image" name="image" accept="image/*"
                                                    style="width:100%; padding:0.5rem; border: 1px solid #ddd; border-radius: 4px; background-color: #fff;">
                                                <button type="button" id="btn-preview-image"
                                                    style="display: none; width: auto; margin-top: 8px; background-color: #6c757d; color: #fff; border: none; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.85em;">
                                                    👁️ ดูรูปตัวอย่าง (Preview)
                                                </button>
                                            </div>

                                            <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">📩
                                                ส่งข้อเสนอแนะ (Send Feedback)</button>
                                        </form>
                    </div>
                </div>
            </div>
    </div>
    <!-- Custom Modal for Validation Error -->
    <div id="errorModal"
        style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.5); backdrop-filter: blur(2px);">
        <div
            style="background-color: #fff; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); padding: 30px; border: 1px solid #ddd; width: 90%; max-width: 400px; border-radius: 12px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
            <div style="margin-bottom: 15px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="#dc3545" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                    <path
                        d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                </svg>
            </div>
            <h3 style="color: #333; margin-bottom: 10px; font-weight: 600;">ไฟล์ไม่ถูกต้อง (Invalid File)</h3>
            <p style="color: #666; margin-bottom: 20px;">กรุณาอัปโหลดไฟล์รูปภาพเท่านั้น<br>(Please upload only image
                files)</p>
            <button id="closeModalBtn" class="btn btn-primary" style="padding: 8px 25px; border-radius: 20px;">ตกลง
                (OK)</button>
        </div>
    </div>

    <!-- Image Preview Modal -->
    <div id="previewModal"
        style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.4); backdrop-filter: blur(1px);">
        <div style="margin: 5% auto; width: 80%; max-width: 800px; text-align: center; position: relative;">
            <span id="closePreviewBtn"
                style="position: absolute; top: -40px; right: 0; color: #fff; font-size: 40px; font-weight: bold; cursor: pointer; text-shadow: 0 0 3px #000;">&times;</span>
            <img id="modal-preview-image"
                style="width: 100%; max-height: 80vh; object-fit: contain; border-radius: 4px; box-shadow: none;">
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Elements
            const errorModal = document.getElementById("errorModal");
            const closeErrorBtn = document.getElementById("closeModalBtn");
            const imageInput = document.getElementById('image');

            const previewBtn = document.getElementById('btn-preview-image');
            const previewModal = document.getElementById("previewModal");
            const closePreviewBtn = document.getElementById("closePreviewBtn");
            const modalPreviewImg = document.getElementById("modal-preview-image");

            let currentPreviewUrl = null;

            // --- Error Modal Logic ---
            if (closeErrorBtn) {
                closeErrorBtn.onclick = function () {
                    errorModal.style.display = "none";
                }
            }
            // Close modals on click outside
            window.onclick = function (event) {
                if (event.target == errorModal) errorModal.style.display = "none";
                if (event.target == previewModal) previewModal.style.display = "none";
            }

            // --- Preview Modal Logic ---
            if (closePreviewBtn) {
                closePreviewBtn.onclick = function () {
                    previewModal.style.display = "none";
                }
            }

            // --- Button Click ---
            if (previewBtn) {
                previewBtn.addEventListener('click', function () {
                    if (currentPreviewUrl) {
                        modalPreviewImg.src = currentPreviewUrl;
                        previewModal.style.display = "block";
                    }
                });
            }

            // --- File Input Change ---
            if (imageInput) {
                imageInput.addEventListener('change', function (e) {
                    const file = this.files[0];
                    if (file) {
                        if (!file.type.startsWith('image/')) {
                            // Invalid
                            errorModal.style.display = "block";
                            this.value = '';
                            if (previewBtn) previewBtn.style.display = 'none';

                            // Clean up old URL
                            if (currentPreviewUrl) {
                                URL.revokeObjectURL(currentPreviewUrl);
                                currentPreviewUrl = null;
                            }
                        } else {
                            // Valid - Create URL and Show Button
                            if (currentPreviewUrl) {
                                URL.revokeObjectURL(currentPreviewUrl);
                            }
                            currentPreviewUrl = URL.createObjectURL(file);

                            if (previewBtn) {
                                previewBtn.style.display = 'inline-block';
                            }
                        }
                    } else {
                        // Cleared
                        if (previewBtn) previewBtn.style.display = 'none';
                        if (currentPreviewUrl) {
                            URL.revokeObjectURL(currentPreviewUrl);
                            currentPreviewUrl = null;
                        }
                    }
                });
            }
        });
    </script>
</body>

</html>