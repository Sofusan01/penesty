<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feedback</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="app-layout">
        <%- include('../partials/sidebar') %>
            <div class="main-content">
                <div class="dashboard-container">
                    <header>
                        <h1>Feedback</h1>
                    </header>
                    <div class="content card">
                        <% if (locals.success) { %>
                            <div class="alert alert-success"
                                style="padding: 1rem; background-color: #d1fae5; color: #065f46; border-radius: 0.5rem; margin-bottom: 1rem;">
                                <%= success %>
                            </div>
                            <% } %>
                                <% if (locals.error) { %>
                                    <div class="alert alert-danger"
                                        style="padding: 1rem; background-color: #fee2e2; color: #991b1b; border-radius: 0.5rem; margin-bottom: 1rem;">
                                        <%= error %>
                                    </div>
                                    <% } %>

                                        <h3>Submit Feedback</h3>
                                        <form action="/feedback" method="POST">
                                            <div class="form-group">
                                                <label for="feedback">Your Feedback:</label>
                                                <textarea id="feedback" name="message" rows="4" required
                                                    placeholder="Write your feedback here..."
                                                    style="width:100%; padding:0.5rem; border: 1px solid #ddd; border-radius: 4px;"></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Send
                                                Feedback</button>
                                        </form>
                    </div>
                </div>
            </div>
    </div>
</body>

</html>